{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Employ-Minds benchmark run",
  "type": "object",
  "required": ["task_id", "system", "solved", "false_completion", "regression", "critical_miss", "reviewer_catches", "input_tokens", "output_tokens", "wall_seconds"],
  "properties": {
    "task_id": {"type":"string","minLength":1},
    "system": {"type":"string","minLength":1},
    "solved": {"type":"boolean"},
    "false_completion": {"type":"boolean"},
    "regression": {"type":"boolean"},
    "critical_miss": {"type":"boolean"},
    "reviewer_catches": {"type":"integer","minimum":0},
    "input_tokens": {"type":"integer","minimum":0},
    "output_tokens": {"type":"integer","minimum":0},
    "wall_seconds": {"type":"number","minimum":0},
    "notes": {"type":"string"}
  },
  "additionalProperties": false
}
