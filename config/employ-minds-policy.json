{
  "schema_version": 1,
  "name": "employ-minds",
  "version": "1.0.0",
  "default_profile": "standard",
  "profiles": {
    "fast": {
      "description": "Small, local, low-risk change with clear requirements and bounded blast radius.",
      "plan": "mental_or_micro",
      "tdd": "focused_regression_when_behavior_changes",
      "review": ["self_diff_review"],
      "security_gate": "on_trigger",
      "verification": "focused_fresh"
    },
    "standard": {
      "description": "Normal feature, bug fix, integration, or bounded refactor.",
      "plan": "written_short",
      "tdd": "default_for_observable_behavior",
      "review": ["spec_compliance", "code_quality"],
      "security_gate": "on_trigger",
      "verification": "focused_plus_relevant_suite"
    },
    "critical": {
      "description": "High-risk, destructive, security-sensitive, money/data-impacting, or wide-scope work.",
      "plan": "written_explicit_with_rollback",
      "tdd": "required_unless_impractical_with_recorded_equivalent_evidence",
      "review": ["independent_spec_compliance", "independent_code_quality", "security"],
      "security_gate": "required",
      "verification": "full_relevant_suite_plus_claim_evidence"
    }
  },
  "critical_triggers": ["authentication", "authorization", "permissions", "payments", "billing", "money movement", "database migration", "schema migration", "secrets", "cryptography", "production data", "destructive operation", "data deletion", "security boundary", "dependency supply chain", "large refactor", "incident response"],
  "uncertainty_upgrade_triggers": ["unfamiliar API", "recent API behavior", "ambiguous material requirement", "cannot reproduce bug", "failing test with unknown cause", "multiple plausible root causes", "hidden dependency", "scope expansion"],
  "review_order": ["spec_compliance", "code_quality", "security_if_triggered", "verification"],
  "completion_requires_fresh_evidence": true,
  "parallelism_requires_independence": true,
  "reviewer_independence_preferred_for_critical": true,
  "never_claim_success_from_stale_output": true,
  "stop_conditions": ["unresolved_acceptance_criterion", "unexplained_test_failure", "unresolved_critical_security_finding", "unverified_destructive_or_migration_safety", "completion_claim_without_matching_evidence"]
}
